{
  "manifest_version": 3,
  "name": "DODO",
  "version": "0.1.0",
  "description": "Open-source browser agent — bring your own Gemini API key.",
  "action": { "default_title": "DODO", "default_icon": { "128": "icons/spark-128.png" } },
  "icons": { "128": "icons/spark-128.png" },
  "side_panel": { "default_path": "src/sidepanel/index.html" },
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "activeTab", "scripting", "notifications", "alarms"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+L", "mac": "Alt+L" },
      "description": "Open DODO side panel"
    }
  }
}
