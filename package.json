{
  "name": "dodo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source browser agent Chrome extension (Gemini, BYOK).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -b && vite build",
    "build:eval": "tsc -b && vite build --mode eval --outDir dist-eval",
    "eval": "node scripts/eval.mjs",
    "eval:browser": "node scripts/eval.mjs --browser",
    "test:eval": "node --test scripts/eval.test.mjs",
    "typecheck": "tsc -b --noEmit",
    "setup": "node scripts/install.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
